{
  "private": true,
  "name": "slicy",
  "version": "0.0.4",
  "license": "MIT",
  "scripts": {
    "build": "preact build",
    "serve": "sirv build --cors --single",
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider PREACT_APP_VERSION=dev preact watch",
    "dev:linux": "PREACT_APP_VERSION=dev preact watch",
    "lint": "eslint src",
    "test": "jest",
    "build:dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider PREACT_APP_VERSION=dev preact build",
    "deploy:dev": "serverless client deploy -s dev --no-confirm"
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "extends": [
      "preact",
      "plugin:@typescript-eslint/recommended"
    ],
    "ignorePatterns": [
      "build/"
    ]
  },
  "dependencies": {
    "preact": "^10.10.0",
    "preact-render-to-string": "^5.2.1"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.2",
    "@types/jest": "^27.4.1",
    "@typescript-eslint/eslint-plugin": "^5.30.6",
    "@typescript-eslint/parser": "^5.30.6",
    "cross-env": "^7.0.3",
    "eslint": "^8.20.0",
    "eslint-config-preact": "^1.3.0",
    "jest": "^27.5.1",
    "jest-mock": "^29.3.1",
    "jest-preset-preact": "^4.0.5",
    "preact-cli": "^3.4.0",
    "serverless": "^3.25.0",
    "serverless-finch": "^4.0.0",
    "sirv-cli": "^2.0.2",
    "typescript": "^4.5.2"
  },
  "jest": {
    "preset": "jest-preset-preact",
    "setupFiles": [
      "<rootDir>/tests/__mocks__/browserMocks.ts",
      "<rootDir>/tests/__mocks__/setupTests.ts"
    ]
  }
}
